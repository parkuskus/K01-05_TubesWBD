package database

import "strconv"
import "if3110.local/db-platform/internal/contracts"

templ modulePage(title string, nav pageNavigation) {
	<link rel="stylesheet" href="/static/database.css"/>
	<section class="db-module">
		<nav class="db-nav" aria-label="Navigasi database">
			<a class="topnav-brand" href="/">Teras Data</a>
			<div class="topnav-links">
				<a href="/">Beranda</a>
				if isConnectionsView(nav.View) {
					<a href="/databases/">Database</a>
				} else {
					<a href="/databases/" aria-current="page">Database</a>
				}
				if nav.Admin {
					<a href="/platform/users">Pengguna</a>
					<a href="/platform/groups">Grup dan Akses</a>
					if isConnectionsView(nav.View) {
						<a href="/databases/connections/" aria-current="page">Kelola koneksi</a>
					} else {
						<a href="/databases/connections/">Kelola koneksi</a>
					}
				}
			</div>
		</nav>
		if nav.Database.ID != "" {
			@viewerNavigation(nav)
		} else if nav.View != "" {
			@moduleBreadcrumb(nav)
		}
		<h1>{ title }</h1>
		{ children... }
	</section>
}

templ messagePage(message string, login bool) {
	@modulePage("Permintaan gagal", pageNavigation{}) {
		<p class="db-alert" role="alert">{ message }</p>
		if login {
			<a class="db-button" href="/login">Masuk kembali</a>
		} else {
			<a href="/databases/">Kembali ke daftar database</a>
		}
	}
}

templ connectionsPage(items []Connection, message string) {
	@modulePage("Kelola koneksi", pageNavigation{Admin: true, View: "connections"}) {
		<p>Daftarkan database PostgreSQL, lalu beri akses melalui grup di administrasi platform.</p>
		if message != "" {
			<p class="db-notice" role="status">{ message }</p>
		}
		<a class="db-button" href="/databases/connections/new">Tambah koneksi</a>
		if len(items) == 0 {
			<p class="db-empty">Belum ada koneksi terdaftar. Mulai dengan menambahkan koneksi PostgreSQL.</p>
		} else {
			<div class="db-scroll" tabindex="0" role="region" aria-label="Daftar koneksi">
				<table>
					<caption>Koneksi terdaftar</caption><thead><tr><th>Nama</th><th>Server</th><th>Database</th><th>Username</th><th>TLS</th><th>Tindakan</th></tr></thead>
					<tbody>
						for _, c := range items {
							<tr>
								<th scope="row">{ c.Name }<small class="db-connection-id">ID koneksi { string(c.ID) }</small></th>
								<td>
									{ c.Host }:{ strconv.Itoa(c.Port) }
								</td>
								<td>
									{ c.Database }
								</td>
								<td>
									{ c.Username }
								</td>
								<td>
									{ c.SSLMode }
								</td>
								<td><div class="db-actions"><a href={ templ.URL(connectionURL(c.ID, "edit")) }>Edit</a><a href={ templ.URL(connectionURL(c.ID, "delete")) }>Hapus</a></div></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ connectionForm(id contracts.DatabaseID, c Connection, token, message string, fields map[string]string) {
	@modulePage("Konfigurasi koneksi", connectionFormNav(id)) {
		if message != "" {
			<p class="db-alert" role="alert">{ message }</p>
		}
		<form class="db-form" method="post" action={ templ.URL(formAction(id)) }>
			<input type="hidden" name="gorilla.csrf.Token" value={ token }/>
			<label for="db-name">Nama koneksi</label><input id="db-name" aria-invalid={ strconv.FormatBool(fields["name"] != "") } name="name" aria-describedby="db-name-error" value={ c.Name } maxlength="100" required/>
			@fieldError("name", fields)
			<label for="db-host">Host</label><input id="db-host" aria-invalid={ strconv.FormatBool(fields["host"] != "") } name="host" aria-describedby="db-host-error" value={ c.Host } placeholder="localhost" maxlength="253" required/>
			@fieldError("host", fields)
			<label for="db-port">Port</label><input id="db-port" aria-invalid={ strconv.FormatBool(fields["port"] != "") } type="number" name="port" aria-describedby="db-port-error" value={ strconv.Itoa(c.Port) } min="1" max="65535" required/>
			@fieldError("port", fields)
			<label for="db-database">Nama database</label><input id="db-database" aria-invalid={ strconv.FormatBool(fields["database"] != "") } name="database" aria-describedby="db-database-error" value={ c.Database } maxlength="63" required/>
			@fieldError("database", fields)
			<label for="db-username">Username PostgreSQL</label><input id="db-username" aria-invalid={ strconv.FormatBool(fields["username"] != "") } name="username" aria-describedby="db-username-error" value={ c.Username } maxlength="63" autocomplete="off" required/>
			@fieldError("username", fields)
			<label for="db-password">Password PostgreSQL</label>
			if id == "" {
				<input id="db-password" aria-invalid={ strconv.FormatBool(fields["password"] != "") } name="password" type="password" maxlength="4096" autocomplete="new-password" aria-describedby="db-password-error" required/>
			} else {
				<input id="db-password" aria-invalid={ strconv.FormatBool(fields["password"] != "") } name="password" type="password" maxlength="4096" autocomplete="new-password" aria-describedby="db-password-help db-password-error"/>
				<small id="db-password-help">Kosongkan untuk mempertahankan password saat ini.</small>
			}
			@fieldError("password", fields)
			<label for="db-sslmode">Koneksi TLS</label>
			<select id="db-sslmode" aria-invalid={ strconv.FormatBool(fields["sslmode"] != "") } name="sslmode" aria-describedby="db-tls-help db-sslmode-error" required>
				<option value="disable" selected?={ c.SSLMode == "disable" }>Disable — untuk koneksi lokal</option>
				<option value="require" selected?={ c.SSLMode == "require" }>Require — terenkripsi tanpa verifikasi hostname</option>
				<option value="verify-full" selected?={ c.SSLMode == "verify-full" }>Verify full — verifikasi sertifikat dan hostname</option>
			</select>
			@fieldError("sslmode", fields)
			<small id="db-tls-help">Gunakan verifikasi penuh untuk server dengan sertifikat tepercaya.</small>
			<div class="db-actions"><button type="submit">Simpan koneksi</button><a href="/databases/connections/">Batal</a></div>
		</form>
	}
}

func isConnectionsView(view string) bool {
	return view == "connections" || view == "connections/new" || view == "connections/edit" || view == "connections/delete"
}

func connectionFormNav(id contracts.DatabaseID) pageNavigation {
	if id == "" {
		return pageNavigation{Admin: true, View: "connections/new"}
	}
	return pageNavigation{Admin: true, Schema: string(id), View: "connections/edit"}
}

func formAction(id contracts.DatabaseID) string {
	if id == "" {
		return "/databases/connections/"
	}
	return connectionURL(id, "edit")
}

templ deleteConfirmation(c Connection, token string) {
	@modulePage("Hapus koneksi", pageNavigation{Admin: true, Schema: string(c.ID), View: "connections/delete"}) {
		<p>Hapus koneksi <strong>{ c.Name }</strong> dari platform?</p>
		<p>Database target beserta isinya tidak dihapus. Pengguna tidak lagi dapat mengakses database melalui koneksi ini.</p>
		<form method="post" action={ templ.URL(connectionURL(c.ID, "delete")) }>
			<input type="hidden" name="gorilla.csrf.Token" value={ token }/>
			<div class="db-actions"><button class="db-danger" type="submit">Hapus koneksi</button><a href="/databases/connections/">Batal</a></div>
		</form>
	}
}

templ databasesPage(items []DatabaseChoice, admin bool) {
	@modulePage("Database", pageNavigation{Admin: admin, View: "databases"}) {
		<p>Pilih database untuk melihat schema, tabel, dan data. Tingkat akses menentukan apakah Anda dapat membuat migration.</p>
		if len(items) == 0 {
			<div class="db-empty">
				<p>Belum ada database yang dapat Anda akses.</p>
				if admin {
					<p>Daftarkan koneksi, lalu tambahkan akun Anda ke grup yang memiliki akses. Status admin tidak otomatis memberi akses ke isi database.</p>
					<div class="db-actions"><a href="/databases/connections/">Kelola koneksi</a><a href="/platform/groups">Atur grup dan akses</a></div>
				} else {
					<p>Minta admin menambahkan Anda ke grup yang memiliki akses database.</p>
				}
			</div>
		} else {
			<ul class="db-list">
				for _, c := range items {
					<li><a href={ templ.URL(viewerURL(c.ID, "schemas", "", "", 0)) }>{ c.Name }</a>@accessBadge(c.Level)
</li>
				}
			</ul>
		}
	}
}

templ schemaDiffPage(nav pageNavigation, schemas []string, reference, target string, diff SchemaDiff, token string, canDraft bool) {
	@modulePage("Bandingkan schema", nav) {
		<p>Pilih schema acuan (struktur yang diinginkan) dan schema tujuan (yang akan diubah) di database ini.</p>
		<form class="db-form" method="get" action={ templ.URL(viewerURL(nav.Database.ID, "schemas/diff", "", "", 0)) }>
			<label for="diff-reference">Schema acuan</label>
			<select id="diff-reference" name="reference" required>
				<option value="">Pilih schema</option>
				for _, schema := range schemas {
					<option value={ schema } selected?={ schema == reference }>{ schema }</option>
				}
			</select>
			<label for="diff-target">Schema tujuan</label>
			<select id="diff-target" name="target" required>
				<option value="">Pilih schema</option>
				for _, schema := range schemas {
					<option value={ schema } selected?={ schema == target }>{ schema }</option>
				}
			</select>
			<div class="db-actions"><button type="submit">Bandingkan schema</button><a href={ templ.URL(viewerURL(nav.Database.ID, "schemas", "", "", 0)) }>Kembali ke schema</a></div>
		</form>
		if reference != "" && target != "" {
			<h2>Perubahan: { reference } → { target }</h2>
			if len(diff.Changes) == 0 {
				<p class="db-empty">Tidak ada perubahan yang dapat dibuatkan SQL migration.</p>
			} else {
				<div class="db-scroll" tabindex="0" role="region" aria-label="Hasil perbandingan schema">
					<table><caption>Perubahan schema</caption><thead><tr><th scope="col">Objek</th><th scope="col">Tindakan</th><th scope="col">Sebelum</th><th scope="col">Sesudah</th><th scope="col">Risiko</th></tr></thead><tbody>
						for _, change := range diff.Changes {
							<tr><th scope="row">{ change.Kind } · { change.Table } { change.Name }</th><td>{ change.Action }</td><td>{ change.Before }</td><td>{ change.After }</td><td>
								if change.Risk == RiskDestructive {
									<strong class="db-alert" role="alert">Perubahan destruktif: { change.Table } { change.Name }</strong>
								} else {
									{ string(change.Risk) }
								}
							</td></tr>
						}
					</tbody></table>
				</div>
			}
			if len(diff.Unsupported) > 0 {
				<h2>Tidak didukung</h2>
				<p class="db-alert" role="alert">Objek berikut tidak termasuk SQL otomatis; hasil belum tentu menyamakan seluruh schema.</p>
				<ul class="db-list">
					for _, object := range diff.Unsupported {
						<li>{ object.Kind } · { object.Table } { object.Name }</li>
					}
				</ul>
			}
			if diff.SQL != "" {
				<h2>Kandidat SQL</h2><p>Periksa setiap pernyataan, terutama perubahan destruktif. SQL tidak dijalankan pada halaman ini.</p>
				<pre class="db-scroll"><code>{ diff.SQL }</code></pre>
				if canDraft && nav.Database.Level == contracts.AccessViewEdit {
					<form method="post" action={ templ.URL(viewerURL(nav.Database.ID, "schemas/diff", "", "", 0)) }>
						<input type="hidden" name="gorilla.csrf.Token" value={ token }/>
						<input type="hidden" name="reference" value={ reference }/><input type="hidden" name="target" value={ target }/>
						<button type="submit">Buat draft migration</button>
					</form>
				}
			}
		}
	}
}

templ schemasPage(nav pageNavigation, schemas []string) {
	@modulePage("Schema", nav) {
		<p>Schema mengelompokkan tabel dan view di dalam database. Pilih schema untuk melihat isinya.</p>
		if len(schemas) == 0 {
			<p class="db-empty">Tidak ada schema yang dapat ditampilkan. Hubungi admin untuk memeriksa struktur dan izin koneksi PostgreSQL.</p>
		} else {
			if len(schemas) > 1 {
				<a class="db-button" href={ templ.URL(viewerURL(nav.Database.ID, "schemas/diff", "", "", 0)) }>Bandingkan schema</a>
			}
			<ul class="db-list">
				for _, schema := range schemas {
					<li><a href={ templ.URL(viewerURL(nav.Database.ID, "tables", schema, "", 0)) }>{ schema }</a></li>
				}
			</ul>
		}
	}
}

templ tablesPage(nav pageNavigation, schema string, tables []Table) {
	@modulePage("Tabel · "+schema, nav) {
		if len(tables) == 0 {
			<p class="db-empty">Schema ini belum memiliki tabel atau view.</p>
		} else {
			<ul class="db-list">
				for _, table := range tables {
					<li><a href={ templ.URL(viewerURL(nav.Database.ID, "table", schema, table.Name, 0)) }>{ table.Name }</a><small>{ table.Kind }</small></li>
				}
			</ul>
		}
	}
}

templ tablePage(nav pageNavigation, detail TableDetails) {
	@modulePage(detail.Schema+"."+detail.Name, nav) {
		<div class="db-actions"><a class="db-button" href={ templ.URL(viewerURL(nav.Database.ID, "data", detail.Schema, detail.Name, 1)) }>Lihat data</a></div>
		<h2>Kolom</h2>
		<div class="db-scroll" tabindex="0" role="region" aria-label="Kolom tabel">
			<table>
				<caption>Struktur kolom</caption><thead><tr><th>Nama</th><th>Tipe</th><th>Nullable</th><th>Default / ekspresi</th></tr></thead>
				<tbody>
					for _, column := range detail.Columns {
						<tr>
							<th scope="row">{ column.Name }</th>
							<td>
								{ column.Type }
							</td>
							<td>
								if column.Nullable {
									Ya
								} else {
									Tidak
								}
							</td>
							<td><code>{ column.Default }</code></td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<h2>Constraint</h2>
		@definitionList(detail.Constraints)
		<h2>Index</h2>
		@definitionList(detail.Indexes)
	}
}

templ definitionList(items []Definition) {
	if len(items) == 0 {
		<p class="db-empty">Tidak ada.</p>
	} else {
		<dl class="db-definitions">
			for _, item := range items {
				<dt>{ item.Name }</dt>
				<dd><code>{ item.SQL }</code></dd>
			}
		</dl>
	}
}

templ dataPage(nav pageNavigation, schema, table string, data DataPage) {
	@modulePage("Data · "+schema+"."+table, nav) {
		<a href={ templ.URL(viewerURL(nav.Database.ID, "table", schema, table, 0)) }>Lihat struktur tabel</a>
		<p>Hanya baca · maksimal { strconv.Itoa(PageSize) } baris per halaman. Nilai panjang ditampilkan sebagian.</p>
		if len(data.Rows) == 0 {
			<p class="db-empty">Tidak ada data pada halaman ini.</p>
			if data.Page > 1 {
				<a href={ templ.URL(viewerURL(nav.Database.ID, "data", schema, table, 1)) }>Kembali ke halaman pertama</a>
			}
		} else {
			<div class="db-scroll" tabindex="0" role="region" aria-label="Data tabel">
				<table>
					<caption>Halaman { strconv.Itoa(data.Page) }</caption>
					<thead>
						<tr>
							for _, column := range data.Columns {
								<th scope="col">{ column }</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, row := range data.Rows {
							<tr>
								for _, cell := range row {
									<td>
										if cell.Null {
											<em class="db-null">NULL</em>
										} else {
											<span class="db-value">{ cell.String() }</span>
										}
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<nav class="db-actions" aria-label="Halaman data">
			if data.Page > 1 {
				<a href={ templ.URL(viewerURL(nav.Database.ID, "data", schema, table, data.Page-1)) }>← Sebelumnya</a>
			}
			<span>Halaman { strconv.Itoa(data.Page) }</span>
			if data.HasNext {
				<a href={ templ.URL(viewerURL(nav.Database.ID, "data", schema, table, data.Page+1)) }>Berikutnya →</a>
			}
		</nav>
	}
}

templ fieldError(field string, fields map[string]string) {
	<small id={ "db-" + field + "-error" } class="db-field-error">{ fields[field] }</small>
}

templ accessBadge(level contracts.AccessLevel) {
	<span class="db-badge">
		if level == contracts.AccessViewEdit {
			View + Edit
		} else if level == contracts.AccessViewOnly {
			View Only
		} else {
			Tanpa akses
		}
	</span>
}

templ moduleBreadcrumb(nav pageNavigation) {
	<nav class="db-breadcrumb" aria-label="Jejak navigasi">
		if nav.View == "databases" {
			<a class="nav-back-btn" href="/">← Kembali ke beranda</a>
			<span class="nav-path-divider" aria-hidden="true">|</span>
			<div class="nav-path-trail">
				<span aria-current="page">databases</span>
			</div>
		} else if nav.View == "connections" {
			<a class="nav-back-btn" href="/databases/">← Kembali ke database</a>
			<span class="nav-path-divider" aria-hidden="true">|</span>
			<div class="nav-path-trail">
				<a href="/databases/">databases</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">connections</span>
			</div>
		} else if nav.View == "connections/new" {
			<a class="nav-back-btn" href="/databases/connections/">← Kembali ke koneksi</a>
			<span class="nav-path-divider" aria-hidden="true">|</span>
			<div class="nav-path-trail">
				<a href="/databases/">databases</a>
				<span aria-hidden="true">/</span>
				<a href="/databases/connections/">connections</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">new</span>
			</div>
		} else if nav.View == "connections/edit" {
			<a class="nav-back-btn" href="/databases/connections/">← Kembali ke koneksi</a>
			<span class="nav-path-divider" aria-hidden="true">|</span>
			<div class="nav-path-trail">
				<a href="/databases/">databases</a>
				<span aria-hidden="true">/</span>
				<a href="/databases/connections/">connections</a>
				<span aria-hidden="true">/</span>
				<span>{ nav.Schema }</span>
				<span aria-hidden="true">/</span>
				<span aria-current="page">edit</span>
			</div>
		} else if nav.View == "connections/delete" {
			<a class="nav-back-btn" href="/databases/connections/">← Kembali ke koneksi</a>
			<span class="nav-path-divider" aria-hidden="true">|</span>
			<div class="nav-path-trail">
				<a href="/databases/">databases</a>
				<span aria-hidden="true">/</span>
				<a href="/databases/connections/">connections</a>
				<span aria-hidden="true">/</span>
				<span>{ nav.Schema }</span>
				<span aria-hidden="true">/</span>
				<span aria-current="page">delete</span>
			</div>
		}
	</nav>
}

templ viewerNavigation(nav pageNavigation) {
	<nav class="db-breadcrumb" aria-label="Jejak navigasi">
		if nav.View == "schemas" {
			<a class="nav-back-btn" href="/databases/">← Kembali ke database</a>
		} else if nav.View == "diff" || nav.View == "tables" {
			<a class="nav-back-btn" href={ templ.URL(viewerURL(nav.Database.ID, "schemas", "", "", 0)) }>← Kembali ke schema</a>
		} else if nav.View == "table" {
			<a class="nav-back-btn" href={ templ.URL(viewerURL(nav.Database.ID, "tables", nav.Schema, "", 0)) }>← Kembali ke tabel</a>
		} else if nav.View == "data" {
			<a class="nav-back-btn" href={ templ.URL(viewerURL(nav.Database.ID, "table", nav.Schema, nav.Table, 0)) }>← Kembali ke struktur</a>
		} else {
			<a class="nav-back-btn" href="/databases/">← Kembali</a>
		}
		<span class="nav-path-divider" aria-hidden="true">|</span>
		<div class="nav-path-trail">
			<a href="/databases/">databases</a>
			<span aria-hidden="true">/</span>
			if nav.View == "schemas" {
				<a href={ templ.URL(viewerURL(nav.Database.ID, "schemas", "", "", 0)) }>{ string(nav.Database.ID) }</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">schemas</span>
			} else if nav.View == "diff" {
				<a href={ templ.URL(viewerURL(nav.Database.ID, "schemas", "", "", 0)) }>{ string(nav.Database.ID) }</a>
				<span aria-hidden="true">/</span>
				<a href={ templ.URL(viewerURL(nav.Database.ID, "schemas", "", "", 0)) }>schemas</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">diff</span>
			} else {
				<a href={ templ.URL(viewerURL(nav.Database.ID, "schemas", "", "", 0)) }>{ string(nav.Database.ID) }</a>
				<span aria-hidden="true">/</span>
				<a href={ templ.URL(viewerURL(nav.Database.ID, "schemas", "", "", 0)) }>schemas</a>
				if nav.Schema != "" {
					<span aria-hidden="true">/</span>
					if nav.View == "tables" {
						<span>{ nav.Schema }</span>
						<span aria-hidden="true">/</span>
						<span aria-current="page">tables</span>
					} else {
						<a href={ templ.URL(viewerURL(nav.Database.ID, "tables", nav.Schema, "", 0)) }>{ nav.Schema }</a>
						<span aria-hidden="true">/</span>
						<a href={ templ.URL(viewerURL(nav.Database.ID, "tables", nav.Schema, "", 0)) }>tables</a>
					}
				}
				if nav.Table != "" {
					<span aria-hidden="true">/</span>
					if nav.View == "table" {
						<span aria-current="page">{ nav.Table }</span>
					} else {
						<a href={ templ.URL(viewerURL(nav.Database.ID, "table", nav.Schema, nav.Table, 0)) }>{ nav.Table }</a>
						<span aria-hidden="true">/</span>
						<span aria-current="page">data</span>
					}
				}
			}
		</div>
	</nav>
	<div class="db-context">
		<div class="db-context-info">
			<strong class="db-context-name">{ nav.Database.Name }</strong>
			@accessBadge(nav.Database.Level)
		</div>
		<div class="db-actions">
			<a href={ templ.URL(viewerURL(nav.Database.ID, "migrations", "", "", 0)) }>Riwayat migration</a>
			if nav.Database.Level == contracts.AccessViewEdit {
				<a href={ templ.URL(viewerURL(nav.Database.ID, "migrations/new", "", "", 0)) }>Buat migration</a>
			}
		</div>
	</div>
}
