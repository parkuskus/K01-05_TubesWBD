package migration

import "strconv"
import "net/url"
import "if3110.local/db-platform/internal/ui"

// data tampilan daftar riwayat migration
type HistoryPageData struct {
	DatabaseID   string
	CSRFToken    string
	ErrorMessage string
	Records      []MigrationRecord
	CanEdit      bool
}

// data tampilan editor pembuatan migration baru
type EditorPageData struct {
	DatabaseID   string
	CSRFToken    string
	ErrorMessage string
	Title        string
	SQLText      string
}

// data tampilan detail dan peninjauan satu migration
type DetailPageData struct {
	DatabaseID   string
	CSRFToken    string
	ErrorMessage string
	Record       MigrationRecord
	CanEdit      bool
}

func formatVersion(version int64) string {
	return strconv.FormatInt(version, 10)
}

func schemasURL(dbID string) string {
	return "/databases/" + url.PathEscape(dbID) + "/schemas"
}

func historyURL(dbID string) string {
	return "/databases/" + url.PathEscape(dbID) + "/migrations"
}

func newMigrationURL(dbID string) string {
	return historyURL(dbID) + "/new"
}

func detailMigrationURL(dbID string, version int64) string {
	return historyURL(dbID) + "/" + formatVersion(version)
}

func editMigrationURL(dbID string, version int64) string {
	return detailMigrationURL(dbID, version) + "/edit"
}

func executeMigrationURL(dbID string, version int64) string {
	return detailMigrationURL(dbID, version) + "/execute"
}

templ historyPage(data HistoryPageData) {
	@ui.Layout("Riwayat Migration · " + data.DatabaseID, historyContent(data))
}

templ historyContent(data HistoryPageData) {
	<section class="migration-shell">
		<link rel="stylesheet" href="/static/platform.css"/>
		<nav class="migration-nav" aria-label="Navigasi utama">
			<a href="/">Beranda</a>
			<a href="/databases/">Database</a>
			<a href={ templ.URL(schemasURL(data.DatabaseID)) }>Lihat Schema</a>
		</nav>
		<nav class="migration-breadcrumb" aria-label="Jejak navigasi">
			<a href="/databases/">Database</a>
			<span aria-hidden="true">/</span>
			<a href={ templ.URL(schemasURL(data.DatabaseID)) }>{ data.DatabaseID }</a>
			<span aria-hidden="true">/</span>
			<span aria-current="page">Riwayat Migration</span>
		</nav>
		<p class="eyebrow">Database · { data.DatabaseID }</p>
		<header class="migration-header">
			<div>
				<h1>Riwayat Migration</h1>
				<p class="migration-lead">Tinjau urutan perubahan struktur dan data SQL yang pernah dijalankan pada database ini.</p>
			</div>
			if data.CanEdit {
				<a class="migration-link-button" href={ templ.URL(newMigrationURL(data.DatabaseID)) }>Buat Migration Baru</a>
			}
		</header>
		if data.ErrorMessage != "" {
			<p class="error-message" role="alert">{ data.ErrorMessage }</p>
		}
		if len(data.Records) == 0 {
			<div class="migration-empty">
				<p>Belum ada riwayat migration pada database ini.</p>
				if data.CanEdit {
					<p>Mulai dengan menyusun draft SQL baru untuk ditinjau sebelum dieksekusi ke database target.</p>
				} else {
					<p>Anda memiliki akses baca (View Only). Pembuatan dan eksekusi migration memerlukan akses View + Edit melalui grup.</p>
				}
			</div>
		} else {
			<div class="migration-scroll" tabindex="0" role="region" aria-label="Daftar riwayat migration">
				<table class="migration-history-table">
					<caption>Daftar versi migration secara berurutan</caption>
					<thead>
						<tr>
							<th scope="col">Versi</th>
							<th scope="col">Judul</th>
							<th scope="col">Status</th>
							<th scope="col">Pembuat</th>
							<th scope="col">Pelaksana</th>
							<th scope="col">Waktu</th>
							<th scope="col">Aksi</th>
						</tr>
					</thead>
					<tbody>
						for _, rec := range data.Records {
							<tr>
								<th scope="row">#{ formatVersion(rec.Version) }</th>
								<td>
									if rec.Title != "" {
										{ rec.Title }
									} else {
										<span>Tanpa judul</span>
									}
								</td>
								<td><span class={ "migration-status migration-status-" + string(rec.Status) }>{ string(rec.Status) }</span></td>
								<td>{ string(rec.CreatedBy) }</td>
								<td>
									if rec.ExecutedBy != "" {
										{ string(rec.ExecutedBy) }
									} else {
										<span>-</span>
									}
								</td>
								<td>
									if rec.ExecutedAt != nil {
										{ rec.ExecutedAt.Format("2006-01-02 15:04:05 UTC") }
									} else {
										{ rec.CreatedAt.Format("2006-01-02 15:04:05 UTC") }
									}
								</td>
								<td>
									<a href={ templ.URL(detailMigrationURL(data.DatabaseID, rec.Version)) }>Detail</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

templ editorPage(data EditorPageData) {
	@ui.Layout("Buat Migration · " + data.DatabaseID, editorContent(data))
}

templ editorContent(data EditorPageData) {
	<section class="migration-shell">
		<link rel="stylesheet" href="/static/platform.css"/>
		<nav class="migration-nav" aria-label="Navigasi utama">
			<a href="/">Beranda</a>
			<a href="/databases/">Database</a>
			<a href={ templ.URL(schemasURL(data.DatabaseID)) }>Lihat Schema</a>
		</nav>
		<nav class="migration-breadcrumb" aria-label="Jejak navigasi">
			<a href="/databases/">Database</a>
			<span aria-hidden="true">/</span>
			<a href={ templ.URL(schemasURL(data.DatabaseID)) }>{ data.DatabaseID }</a>
			<span aria-hidden="true">/</span>
			<a href={ templ.URL(historyURL(data.DatabaseID)) }>Riwayat Migration</a>
			<span aria-hidden="true">/</span>
			<span aria-current="page">Buat Baru</span>
		</nav>
		<p class="eyebrow">Database · { data.DatabaseID }</p>
		<h1>Migration Query Editor</h1>
		<p class="migration-lead">Susun perubahan struktur atau data dalam bentuk SQL untuk disimpan sebagai draft dan ditinjau sebelum dijalankan.</p>
		<p><a href={ templ.URL(historyURL(data.DatabaseID)) }>Kembali ke Riwayat Migration</a></p>
		if data.ErrorMessage != "" {
			<p class="error-message" role="alert">{ data.ErrorMessage }</p>
		}
		<form class="migration-editor-form" action={ templ.URL(historyURL(data.DatabaseID)) } method="post">
			<input type="hidden" name="gorilla.csrf.Token" value={ data.CSRFToken }/>
			<div class="form-field">
				<label for="title">Judul / Deskripsi Migration</label>
				<input id="title" name="title" type="text" value={ data.Title } placeholder="Contoh: buat tabel users"/>
			</div>
			<div class="form-field">
				<label for="sql_text">Query SQL Migration</label>
				<textarea id="sql_text" name="sql_text" rows="10" required>{ data.SQLText }</textarea>
			</div>
			<div class="migration-warning">
				<p><strong>Tinjau sebelum eksekusi:</strong> Simpan sebagai draft terlebih dahulu untuk meninjau SQL pada halaman detail, atau centang konfirmasi di bawah bila ingin langsung mengeksekusi ke database <strong>{ data.DatabaseID }</strong>.</p>
				<label class="migration-confirm-label" for="confirm_execute">
					<input id="confirm_execute" type="checkbox" name="confirm_execute" value="true"/>
					Saya sudah meninjau query SQL dan memahami dampaknya pada database target
				</label>
			</div>
			<div class="migration-actions">
				<button type="submit" name="action" value="draft">Simpan Draft untuk Ditinjau</button>
				<button type="submit" name="action" value="run">Jalankan Setelah Konfirmasi</button>
			</div>
		</form>
	</section>
}

templ detailPage(data DetailPageData) {
	@ui.Layout("Migration #" + formatVersion(data.Record.Version) + " · " + data.DatabaseID, detailContent(data))
}

templ detailContent(data DetailPageData) {
	<section class="migration-shell">
		<link rel="stylesheet" href="/static/platform.css"/>
		<nav class="migration-nav" aria-label="Navigasi utama">
			<a href="/">Beranda</a>
			<a href="/databases/">Database</a>
			<a href={ templ.URL(schemasURL(data.DatabaseID)) }>Lihat Schema</a>
		</nav>
		<nav class="migration-breadcrumb" aria-label="Jejak navigasi">
			<a href="/databases/">Database</a>
			<span aria-hidden="true">/</span>
			<a href={ templ.URL(schemasURL(data.DatabaseID)) }>{ data.DatabaseID }</a>
			<span aria-hidden="true">/</span>
			<a href={ templ.URL(historyURL(data.DatabaseID)) }>Riwayat Migration</a>
			<span aria-hidden="true">/</span>
			<span aria-current="page">#{ formatVersion(data.Record.Version) }</span>
		</nav>
		<p class="eyebrow">Database · { data.DatabaseID }</p>
		<h1>Migration #{ formatVersion(data.Record.Version) }</h1>
		<p class="migration-lead">Periksa detail eksekusi dan pernyataan SQL yang tercatat untuk versi migration ini.</p>
		<p><a href={ templ.URL(historyURL(data.DatabaseID)) }>Kembali ke Riwayat Migration</a></p>
		if data.ErrorMessage != "" {
			<p class="error-message" role="alert">{ data.ErrorMessage }</p>
		}
		<section class="migration-metadata">
			<p><strong>Judul:</strong> { data.Record.Title }</p>
			<p><strong>Status:</strong> <span class={ "migration-status migration-status-" + string(data.Record.Status) }>{ string(data.Record.Status) }</span></p>
			<p><strong>Dibuat oleh:</strong> { string(data.Record.CreatedBy) } ({ data.Record.CreatedAt.Format("2006-01-02 15:04:05 UTC") })</p>
			if data.Record.ExecutedBy != "" {
				<p><strong>Dieksekusi oleh:</strong> { string(data.Record.ExecutedBy) }</p>
			}
			if data.Record.ExecutedAt != nil {
				<p><strong>Waktu eksekusi:</strong> { data.Record.ExecutedAt.Format("2006-01-02 15:04:05 UTC") }</p>
			}
			if data.Record.ErrorMessage != "" {
				<p class="error-message" role="alert"><strong>Error Eksekusi:</strong> Eksekusi SQL gagal.</p>
			}
		</section>
		<section class="migration-sql-section">
			<h2>SQL Migration</h2>
			<pre class="migration-sql-preview"><code>{ data.Record.SQLText }</code></pre>
		</section>
		if data.Record.Status == StatusDraft && data.CanEdit {
			<section class="migration-draft-controls">
				<h2>Ubah Draft SQL</h2>
				<form class="migration-editor-form" action={ templ.URL(editMigrationURL(data.DatabaseID, data.Record.Version)) } method="post">
					<input type="hidden" name="gorilla.csrf.Token" value={ data.CSRFToken }/>
					<div class="form-field">
						<label for="title">Judul / Deskripsi Migration</label>
						<input id="title" name="title" type="text" value={ data.Record.Title }/>
					</div>
					<div class="form-field">
						<label for="sql_text">Query SQL Migration</label>
						<textarea id="sql_text" name="sql_text" rows="8" required>{ data.Record.SQLText }</textarea>
					</div>
					<button type="submit">Simpan Perubahan Draft</button>
				</form>
				<form class="migration-execute-form" action={ templ.URL(executeMigrationURL(data.DatabaseID, data.Record.Version)) } method="post">
					<input type="hidden" name="gorilla.csrf.Token" value={ data.CSRFToken }/>
					<div class="migration-warning">
						<p><strong>Konfirmasi Eksekusi Migration #{ formatVersion(data.Record.Version) }</strong></p>
						<p>Target database: <strong>{ data.DatabaseID }</strong> · Judul: <strong>{ data.Record.Title }</strong></p>
						<p>Perubahan struktur atau data akan dijalankan di dalam transaksi PostgreSQL dan mungkin sulit dibatalkan setelah di-commit.</p>
						<label class="migration-confirm-label" for="confirm_execute">
							<input id="confirm_execute" type="checkbox" name="confirm_execute" value="true" required/>
							Saya sudah meninjau query SQL dan memahami dampaknya pada database target
						</label>
					</div>
					<button type="submit">Eksekusi Migration (Transaction)</button>
				</form>
			</section>
		}
	</section>
}
