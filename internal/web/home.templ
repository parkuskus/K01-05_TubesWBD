package web

import "if3110.local/db-platform/internal/ui"

templ home(csrfToken string, isAdmin bool) {
	@ui.Layout("Database Management Platform", homeContent(csrfToken, isAdmin))
}

templ homeContent(csrfToken string, isAdmin bool) {
	<section class="home-shell">
		<div class="home-topbar">
			<div class="home-topbar-inner">
				<a class="topnav-brand" href="/">Teras Data</a>
				<div class="topnav-links">
					<a class="home-topbar-link" href="/" aria-current="page">Beranda</a>
					<a class="home-topbar-link" href="/databases/">Database</a>
					if isAdmin {
						<a class="home-topbar-link" href="/platform/users">Pengguna</a>
						<a class="home-topbar-link" href="/platform/groups">Grup dan Akses</a>
						<a class="home-topbar-link" href="/databases/connections/">Kelola koneksi</a>
					}
					<form class="logout-form" action="/logout" method="post">
						<input type="hidden" name="gorilla.csrf.Token" value={ csrfToken }/>
						<button type="submit">Keluar</button>
					</form>
				</div>
			</div>
		</div>
		<nav class="home-breadcrumb" aria-label="Jejak navigasi">
			<div class="home-breadcrumb-inner">
				<div class="nav-path-trail">
					<span aria-current="page">beranda</span>
				</div>
			</div>
		</nav>
		<div class="home-frame">
			<header class="home-header">
				<h1>Database Management Platform</h1>
				<p class="home-lead">Pilih database untuk melihat schema, tabel, dan data, atau kelola pengguna dan hak akses.</p>
			</header>
			<div class="home-grid">
				<section class="home-card" aria-label="Database">
					<div>
						<h2>Database</h2>
						<p>Lihat daftar database, struktur tabel, isi data, dan riwayat migration SQL.</p>
					</div>
					<div class="home-actions">
						<a class="button-primary" href="/databases/">Pilih database</a>
					</div>
				</section>
				if isAdmin {
					<section class="home-card" aria-label="Administrasi">
						<div>
							<h2>Administrasi</h2>
							<p>Kelola akun pengguna, grup akses, dan koneksi database.</p>
						</div>
						<nav class="home-actions" aria-label="Pintasan administrasi">
							<a class="home-row-action" href="/platform/users">Pengguna</a>
							<a class="home-row-action" href="/platform/groups">Grup dan akses</a>
							<a class="home-row-action" href="/databases/connections/">Koneksi database</a>
						</nav>
					</section>
				}
			</div>
		</div>
	</section>
}
