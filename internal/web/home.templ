package web

templ home(csrfToken string) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Database Management Platform</title>
			<link rel="stylesheet" href="/static/styles.css"/>
		</head>
		<body>
			<main>
				<p class="eyebrow">IF3110 · Milestone 1</p>
				<h1>Database Management Platform</h1>
				<p>Anda sudah masuk ke platform.</p>
				<form class="logout-form" action="/logout" method="post">
					<input type="hidden" name="gorilla.csrf.Token" value={ csrfToken }/>
					<button type="submit">Keluar</button>
				</form>
			</main>
		</body>
	</html>
}
