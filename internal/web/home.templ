package web

import "if3110.local/db-platform/internal/ui"

templ home(csrfToken string, isAdmin bool) {
	@ui.Layout("Database Management Platform", homeContent(csrfToken, isAdmin))
}

templ homeContent(csrfToken string, isAdmin bool) {
	<section class="home-shell">
		<div class="home-topbar">
			<div class="home-topbar-inner">
				<span class="home-brand-title">Teras Data</span>
				<div class="home-topbar-right">
					<a class="home-topbar-link" href="/databases/">Database</a>
					if isAdmin {
						<a class="home-topbar-link" href="/platform/users">Pengguna</a>
						<a class="home-topbar-link" href="/platform/groups">Grup dan Akses</a>
						<a class="home-topbar-link" href="/databases/connections/">Koneksi</a>
					}
					<form class="logout-form" action="/logout" method="post">
						<input type="hidden" name="gorilla.csrf.Token" value={ csrfToken }/>
						<button type="submit">Keluar</button>
					</form>
				</div>
			</div>
		</div>
		<header class="home-hero">
			<div class="home-hero-inner">
				<p class="eyebrow">IF3110 · Milestone 1</p>
				<h1>Database Management Platform</h1>
				<p class="home-lead">Eksplorasi schema, inspeksi data berhalaman, dan eksekusi migration SQL transaksional dengan kendali akses berbasis grup.</p>
				<div class="home-hero-actions">
					<a class="button-primary" href="/databases/">Buka Database</a>
					if isAdmin {
						<a class="button-secondary-pill" href="/databases/connections/">Kelola Koneksi</a>
					}
				</div>
			</div>
		</header>
		<div class="home-grid-section">
			<div class="home-grid">
				<section class="home-card" aria-label="Eksplorasi database">
					<div class="home-card-head">
						<p class="card-kicker">Workspace Utama</p>
						<h2>Database dan Migration</h2>
						<p>Telusuri daftar database PostgreSQL yang diizinkan bagi grup Anda, periksa struktur kolom, constraint, index, baris data, serta riwayat migration linear.</p>
					</div>
					<div class="home-actions">
						<a class="button-primary" href="/databases/">Pilih database</a>
					</div>
				</section>
				if isAdmin {
					<section class="home-card" aria-label="Administrasi platform">
						<div class="home-card-head">
							<p class="card-kicker">Tata Kelola</p>
							<h2>Administrasi Platform</h2>
							<p>Kelola akun pengguna, grup, koneksi PostgreSQL, dan hak akses grup. Status Platform Admin terpisah dari izin akses ke isi database target.</p>
						</div>
						<nav class="home-actions" aria-label="Pintasan administrasi">
							<a class="home-link" href="/platform/users">Pengguna</a>
							<a class="home-link" href="/platform/groups">Grup dan akses</a>
							<a class="home-link" href="/databases/connections/">Koneksi database</a>
						</nav>
					</section>
				}
			</div>
		</div>
	</section>
}
